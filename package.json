{
  "name": "nx-tanstack-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "admin": "nx serve admin",
    "build:admin": "nx build admin",
    "backend": "nx serve backend",
    "build:backend": "nx build backend",
    "test:backend": "nx test backend",
    "storefront": "nx serve storefront",
    "build:storefront": "nx build storefront",
    "test:storefront": "nx test storefront",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f postgres",
    "typecheck": "nx run-many -t typecheck",
    "deps": "nx graph",
    "db:seed": "tsx apps/backend/prisma/seed.ts",
    "routes:gen": "node scripts/gen-routes.mjs",
    "gen:openapi": "pnpm build:backend && node apps/backend/scripts/generate-openapi.cjs",
    "gen:api-types": "pnpm gen:openapi && openapi-typescript apps/backend/openapi.json -o apps/admin/src/lib/api-types.gen.ts",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "7.8.0"
  },
  "devDependencies": {
    "@nx/js": "^22.7.5",
    "@nx/nest": "^22.7.5",
    "@nx/react": "^22.7.5",
    "@nx/vite": "^22.7.5",
    "@types/node": "^26.1.2",
    "nx": "^22.7.5",
    "openapi-typescript": "^7.13.0",
    "prisma": "^7.8.0",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
